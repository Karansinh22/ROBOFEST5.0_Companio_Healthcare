<?xml version="1.0"?>
<!--
  Companio healthcare robot - kinematic model.
  Differential-drive base with an RPLidar A1 on the sensor tower, a pan/tilt
  Intel RealSense D415 and two 4-DOF servo arms with grippers.
  Frames used by navigation: base_footprint -> base_link -> laser.
-->
<robot name="companio" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="wheel_radius" value="0.09"/>
<xacro:property name="wheel_width" value="0.05"/>

<link name="base_footprint"/>

<joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.125"/> <!-- Adjusted considering base_link box height 0.15 + clearance -->
</joint>

<link name="base_link">
  <inertial>
    <mass value="20"/>
    <origin xyz="0 0 0"/>
    <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
  </inertial>

  <visual>
    <geometry>
      <box size="0.4 0.35 0.15"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.4 0.35 0.15"/>
    </geometry>
  </collision>
</link>

<!-- LEFT WHEEL -->
<link name="left_wheel">
  <visual>
    <geometry>
      <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
    </geometry>
  </visual>
</link>

<joint name="left_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="0 0.18 -0.05" rpy="0 1.57 0"/>
  <axis xyz="0 0 1"/>
</joint>

<!-- RIGHT WHEEL -->
<link name="right_wheel">
  <visual>
    <geometry>
      <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
    </geometry>
  </visual>
</link>

<joint name="right_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="0 -0.18 -0.05" rpy="0 1.57 0"/>
  <axis xyz="0 0 1"/>
</joint>

<!-- BATTERY BOX -->
<link name="battery_box">
  <visual>
    <geometry>
      <box size="0.3 0.25 0.2"/>
    </geometry>
  </visual>
</link>

<joint name="battery_joint" type="fixed">
  <parent link="base_link"/>
  <child link="battery_box"/>
  <origin xyz="-0.2 0 0"/>
</joint>

<!-- LIDAR -->
<link name="laser">
  <visual>
    <geometry>
      <cylinder radius="0.06" length="0.05"/>
    </geometry>
  </visual>
</link>

<joint name="lidar_joint" type="fixed">
  <parent link="base_link"/>
  <child link="laser"/>
  <origin xyz="0 0 0.25" rpy="0 0 3.14159"/>
</joint>

<!-- CAMERA -->
<link name="camera_link">
  <visual>
    <geometry>
      <box size="0.06 0.06 0.04"/>
    </geometry>
  </visual>
</link>

<joint name="camera_tilt_joint" type="revolute">
  <parent link="base_link"/>
  <child link="camera_link"/>
  <origin xyz="0.15 0 0.15"/>
  <axis xyz="0 1 0"/>
  <limit effort="10" velocity="1" lower="-1.57" upper="1.57"/>
</joint>

<!-- LEFT ARM -->
<link name="left_arm_base"/>

<joint name="left_shoulder_joint" type="revolute">
  <parent link="base_link"/>
  <child link="left_arm_base"/>
  <origin xyz="0.1 0.18 0.15"/>
  <axis xyz="0 0 1"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<link name="left_elbow_link"/>

<joint name="left_elbow_joint" type="revolute">
  <parent link="left_arm_base"/>
  <child link="left_elbow_link"/>
  <origin xyz="0.12 0 0"/>
  <axis xyz="0 1 0"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<link name="left_gripper_rotate"/>

<joint name="left_gripper_rotate_joint" type="revolute">
  <parent link="left_elbow_link"/>
  <child link="left_gripper_rotate"/>
  <origin xyz="0.12 0 0"/>
  <axis xyz="1 0 0"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<link name="left_gripper"/>

<joint name="left_gripper_joint" type="revolute">
  <parent link="left_gripper_rotate"/>
  <child link="left_gripper"/>
  <origin xyz="0.05 0 0"/>
  <axis xyz="0 1 0"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<!-- RIGHT ARM -->
<link name="right_arm_base"/>

<joint name="right_shoulder_joint" type="revolute">
  <parent link="base_link"/>
  <child link="right_arm_base"/>
  <origin xyz="0.1 -0.18 0.15"/>
  <axis xyz="0 0 1"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<link name="right_elbow_link"/>

<joint name="right_elbow_joint" type="revolute">
  <parent link="right_arm_base"/>
  <child link="right_elbow_link"/>
  <origin xyz="0.12 0 0"/>
  <axis xyz="0 1 0"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<link name="right_gripper_rotate"/>

<joint name="right_gripper_rotate_joint" type="revolute">
  <parent link="right_elbow_link"/>
  <child link="right_gripper_rotate"/>
  <origin xyz="0.12 0 0"/>
  <axis xyz="1 0 0"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

<link name="right_gripper"/>

<joint name="right_gripper_joint" type="revolute">
  <parent link="right_gripper_rotate"/>
  <child link="right_gripper"/>
  <origin xyz="0.05 0 0"/>
  <axis xyz="0 1 0"/>
  <limit effort="10" velocity="1" lower="-3.14" upper="3.14"/>
</joint>

</robot>