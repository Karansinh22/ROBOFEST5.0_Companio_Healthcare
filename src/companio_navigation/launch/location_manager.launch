<?xml version="1.0"?>
<launch>
  <!-- Named-location manager: save/list/delete rooms and send the robot to them. -->
  <arg name="map_name" default="hospital_map"/>
  <arg name="maps_dir" default="$(find companio_description)/maps"/>
  <arg name="locations_file" default="$(arg maps_dir)/$(arg map_name).locations.yaml"/>
  <arg name="navigation_enabled" default="true"/>

  <node pkg="companio_navigation" type="location_manager.py" name="location_manager" output="screen">
    <param name="locations_file" value="$(arg locations_file)"/>
    <param name="map_name" value="$(arg map_name)"/>
    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="navigation_enabled" value="$(arg navigation_enabled)"/>
    <param name="pose_publish_rate" value="5.0"/>
  </node>
</launch>
