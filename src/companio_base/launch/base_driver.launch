<?xml version="1.0"?>
<launch>
  <!--
    Motor driver, cmd_vel mixing and wheel odometry for the Companio base.
    Parameters are loaded from config/base.yaml; the top-level keys of that
    file match the node names below so each node picks up its private params.
  -->
  <arg name="config" default="$(find companio_base)/config/base.yaml"/>
  <rosparam file="$(arg config)" command="load"/>

  <node pkg="companio_base" type="motor_driver_node.py" name="motor_driver" output="screen" respawn="false"/>
  <node pkg="companio_base" type="cmd_vel_to_wheels.py" name="cmd_vel_to_wheels" output="screen"/>
  <node pkg="companio_base" type="wheel_odometry.py" name="wheel_odometry" output="screen"/>
</launch>
