<?xml version="1.0"?>
<launch>
  <!-- rosbridge websocket + HTTP server for the dashboard -->
  <arg name="http_port" default="8000"/>
  <arg name="rosbridge_port" default="9090"/>

  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="$(arg rosbridge_port)"/>
  </include>

  <node pkg="companio_web" type="web_server.py" name="web_server" output="screen">
    <param name="port" value="$(arg http_port)"/>
  </node>
</launch>
