<?xml version="1.0"?>
<launch>
  <!--
    Autonomous navigation on a saved map.
      * map_server + AMCL + move_base (DWA)
      * location manager: rooms saved during mapping are loaded from
        companio_description/maps/<map_name>.locations.yaml
      * RViz navigation view (2D Pose Estimate / 2D Nav Goal / Publish Point = save room)
      * web dashboard on http://<robot-ip>:8000
    Give AMCL an initial pose (RViz "2D Pose Estimate", the dashboard, or
    `location_cli.py localize Home`) before sending the first goal.
  -->
  <arg name="map_name" default="hospital_map"/>
  <arg name="maps_dir" default="$(find companio_description)/maps"/>
  <arg name="rviz" default="true"/>
  <arg name="web" default="true"/>
  <arg name="keyboard" default="false"/>
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>

  <include file="$(find companio_bringup)/launch/base.launch"/>

  <node pkg="map_server" type="map_server" name="map_server" args="$(arg maps_dir)/$(arg map_name).yaml"/>

  <include file="$(find companio_navigation)/launch/amcl.launch">
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
  </include>

  <include file="$(find companio_navigation)/launch/move_base.launch"/>

  <include file="$(find companio_navigation)/launch/location_manager.launch">
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="maps_dir" value="$(arg maps_dir)"/>
    <arg name="navigation_enabled" value="true"/>
  </include>

  <node if="$(arg keyboard)" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py"
        name="teleop_keyboard" output="screen"/>

  <include if="$(arg web)" file="$(find companio_web)/launch/web.launch"/>

  <include if="$(arg rviz)" file="$(find companio_description)/launch/rviz.launch">
    <arg name="view" value="navigation"/>
  </include>
</launch>
